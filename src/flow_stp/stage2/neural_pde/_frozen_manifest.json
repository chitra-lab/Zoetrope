{
  "frozen_architecture_version": "eulerian-neural-pde-v1-2026-08-17",
  "stage1_policy": "z is frozen and supplied by Stage 1",
  "decoder": "B(z) + D(z,rho) - D(z,0)",
  "pde": "rho_t + V(z,t) rho_z = q(z,t)",
  "benchmark_defaults": {
    "baseline_hidden": [64, 64],
    "decoder_hidden": [64, 64],
    "dynamic_hidden": [96, 96, 96],
    "baseline_activation": "gelu",
    "decoder_activation": "gelu",
    "velocity_activation": "tanh",
    "source_activation": "silu",
    "source_output_activation": "relu",
    "source_initial_bias": 0.4,
    "train_rk4_steps": 16,
    "decoder_output_initial_std": 0.001,
    "source_output_initial_std": 0.001,
    "baseline_lr": 0.002,
    "dynamic_lr": 0.001,
    "decoder_lr": 0.0015,
    "grad_clip": 5.0
  },
  "important_choice": "expression is decoded at current z, not material origin a",
  "velocity_boundary_constraint": "none"
}
